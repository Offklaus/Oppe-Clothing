{
  "name": "oppe-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do catálogo Oppe Clothing: peças, dados da loja e pedidos pelo WhatsApp.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js --porta=3001",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "db:migrar": "node src/db/cli.js migrar",
    "db:semear": "node src/db/cli.js semear",
    "db:preparar": "node src/db/cli.js preparar",
    "admin:criar": "node src/db/criar-admin.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}

# Copie este arquivo para .env e preencha. O .env nunca vai para o git.

# Banco PostgreSQL. Use um usuário próprio da aplicação, nunca o superusuário "postgres".
DATABASE_URL=postgres://oppe_app:SENHA_DO_USUARIO@localhost:5432/oppe_dev
# Banco separado para os testes automáticos (npm test apaga os dados dele)
DATABASE_URL_TESTE=postgres://oppe_app:SENHA_DO_USUARIO@localhost:5432/oppe_test

# Endereço público do site (links das peças na mensagem e proteção CSRF do painel).
# Em produção: o domínio da loja, ex.: https://oppeclothing.com.br
SITE_URL=http://localhost:5173

# Porta da API em produção (em dev o script usa 3001)
PORT=3001

# Em produção:
# NODE_ENV=production   -> HSTS ligado (o cookie do painel já é só-HTTPS quando SITE_URL começa com https://)
# TRUST_PROXY=1         -> SÓ se houver um proxy na frente (Render, Railway, Nginx). Sem proxy, deixe vazio:
#                          o servidor ignora o X-Forwarded-For e ninguém consegue inventar o próprio IP.
# ORIGENS_EXTRAS=https://www.oppeclothing.com.br   -> outros endereços que podem usar o painel

# ---------- Produção com Supabase ----------
# DATABASE_URL: use a string do "Session pooler" (porta 5432), não a conexão direta (só IPv6) nem a
# "Transaction pooler" (6543). Ex.: postgresql://postgres.REF:SENHA@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# DATABASE_CA_CERT: conteúdo do certificado do Supabase (Dashboard → Database → Settings → SSL Configuration
#   → Download certificate). Pode colar em uma linha trocando as quebras por \n.
# DATABASE_CA_CERT=
# Fotos do painel no Supabase Storage (bucket público "produtos"). A chave secreta fica SÓ no servidor.
# SUPABASE_URL=https://REF.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=produtos

# Usado só na primeira carga do banco (depois o WhatsApp é editado no painel, em Loja)
WHATSAPP_NUMERO=

# Opcional: cria o admin sem perguntas ao rodar npm run admin:criar
# ADMIN_EMAIL=
# ADMIN_NOME=
# ADMIN_SENHA=

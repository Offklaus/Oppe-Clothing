# Copie este arquivo para .env e preencha. O .env nunca vai para o git.

# Banco PostgreSQL. Use um usuário próprio da aplicação, nunca o superusuário "postgres".
DATABASE_URL=postgres://oppe_app:SENHA_DO_USUARIO@localhost:5432/oppe_dev
# Banco separado para os testes automáticos (npm test apaga os dados dele)
DATABASE_URL_TESTE=postgres://oppe_app:SENHA_DO_USUARIO@localhost:5432/oppe_test

# Endereço público do site (links das peças na mensagem e proteção CSRF do painel).
# Em produção: o domínio da loja, ex.: https://oppeclothing.com.br
SITE_URL=http://localhost:5173

# Porta da API em produção (em dev o script usa 3001)
PORT=3001

# Em produção:
# NODE_ENV=production   -> cookie do painel só por HTTPS, HSTS ligado
# TRUST_PROXY=1         -> quando o servidor fica atrás de um proxy (Render, Railway, Nginx)
# ORIGENS_EXTRAS=https://www.oppeclothing.com.br   -> outros endereços que podem usar o painel

# Usado só na primeira carga do banco (depois o WhatsApp é editado no painel, em Loja)
WHATSAPP_NUMERO=

# Opcional: cria o admin sem perguntas ao rodar npm run admin:criar
# ADMIN_EMAIL=
# ADMIN_NOME=
# ADMIN_SENHA=
